FROM golang:1.27.4 AS build
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY examples/rolling-deployment/app ./examples/rolling-deployment/app
RUN CGO_ENABLED=0 go build -trimpath -ldflags="-s -w" -o /app ./examples/rolling-deployment/app

FROM scratch
COPY --from=build /app /app
USER 65532:65532
ENV APP_VERSION=new PORT=8080
EXPOSE 8080
ENTRYPOINT ["/app"]
